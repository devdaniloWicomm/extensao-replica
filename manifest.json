{
  "manifest_version": 3,
  "name": "Gerador de Emails — ponte do Figma",
  "version": "0.1.0",
  "description": "Busca as imagens de uma colagem do Figma usando a sessão do próprio usuário, e entrega ao editor. Não lê, não copia e não guarda credencial.",
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gerador-emails.vercel.app/*",
        "http://localhost:3100/*",
        "http://127.0.0.1:3100/*"
      ],
      "js": ["ponte.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.figma.com/*", "https://s3-alpha-sig.figma.com/*"],
  "action": {
    "default_popup": "teste.html",
    "default_title": "Ponte do Figma — teste"
  }
}
