{
  "manifest_version": 3,
  "name": "Gerador de Emails — ponte do Figma",
  "version": "0.3.2",
  "description": "Exporta as imagens de uma colagem do Figma pelo próprio Figma, na aba do arquivo. Não lê, não copia e não guarda credencial, e não altera o arquivo.",
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gerador-emails.vercel.app/*",
        "http://localhost:3100/*",
        "http://127.0.0.1:3100/*"
      ],
      "js": ["ponte.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.figma.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ponte do Figma"
  }
}
